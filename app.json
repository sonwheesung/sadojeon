{
  "expo": {
    "name": "Shidao",
    "slug": "shidao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shidao",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/08f9ecbe-9a3d-4c94-a415-1529db03a82c"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shidao.app"
    },
    "android": {
      "package": "com.shidao.app",
      "adaptiveIcon": {
        "backgroundColor": "#D4C5A0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D4C5A0",
          "dark": {
            "backgroundColor": "#1A1612"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "newArchEnabled": true
          },
          "android": {
            "minSdkVersion": 28,
            "newArchEnabled": true
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "ko": {}
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08f9ecbe-9a3d-4c94-a415-1529db03a82c"
      }
    },
    "owner": "shs00925"
  }
}
